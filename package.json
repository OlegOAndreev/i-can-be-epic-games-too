    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.0.0",
